{
  "name": "mirror-to-analytics",
  "config": {
    "connector.class": "org.apache.kafka.connect.mirror.MirrorSourceConnector",
    "tasks.max": "1",
    "source.cluster.alias": "primary",
    "target.cluster.alias": "analytics",
    "source.cluster.bootstrap.servers": "localhost:19092,localhost:19094,localhost:19096",
    "target.cluster.bootstrap.servers": "localhost:19192",
    "topics": "shop.products.clean,client.searches",
    "replication.factor": "1",
    "offset-syncs.topic.replication.factor": "3",
    "heartbeats.topic.replication.factor": "1",
    "checkpoints.topic.replication.factor": "1",
    "sync.topic.acls.enabled": "false",
    "sync.topic.configs.enabled": "false",
    "refresh.topics.interval.seconds": "5",
    "source.cluster.security.protocol": "SSL",
    "source.cluster.ssl.keystore.location": "D:/kaf/marketplace/secrets/clients/connect.keystore.p12",
    "source.cluster.ssl.keystore.password": "your-password",
    "source.cluster.ssl.keystore.type": "PKCS12",
    "source.cluster.ssl.key.password": "your-password",
    "source.cluster.ssl.truststore.location": "D:/kaf/marketplace/secrets/clients/truststore.jks",
    "source.cluster.ssl.truststore.password": "your-password",
    "source.cluster.ssl.truststore.type": "JKS",
    "source.cluster.ssl.endpoint.identification.algorithm": "",
    "target.cluster.security.protocol": "SSL",
    "target.cluster.ssl.keystore.location": "D:/kaf/marketplace/secrets/clients/connect.keystore.p12",
    "target.cluster.ssl.keystore.password": "your-password",
    "target.cluster.ssl.keystore.type": "PKCS12",
    "target.cluster.ssl.key.password": "your-password",
    "target.cluster.ssl.truststore.location": "D:/kaf/marketplace/secrets/clients/truststore.jks",
    "target.cluster.ssl.truststore.password": "your-password",
    "target.cluster.ssl.truststore.type": "JKS",
    "target.cluster.ssl.endpoint.identification.algorithm": ""
  }
}
